class Solution {
  public:
    vector<int> topoSort(int V, vector<vector<int>>& edges) {
        unordered_map<int, vector<int>> adj;
        
        for(vector<int> &edge: edges) {
            int u = edge[0];
            int v = edge[1];
            
            adj[u].push_back(v);
        }
        
        vector<int> indegre(V, 0);
        queue<int> q;
        vector<int> result;
        
        // step 1 fill indegree
        for(int u = 0; u < V; u++) {
            for(auto &v: adj[u]) {
                indegre[v]++;
            }
        }
        
        // step 2 push element in queue if the indegree of element is 0
        
        for(int i = 0; i<V; i++) {
            if(indegre[i] == 0) {
                q.push(i);
            }
        }
        
        // step 3 use normal BFS
        
        while(!q.empty()) {
            int u =q.front();
            result.push_back(u);
            q.pop();
            
            for(auto &v: adj[u]) {
                indegre[v]--;
                if(indegre[v] == 0) {
                    q.push(v);
                }
            }
        }
        
        return result;
    }
};
