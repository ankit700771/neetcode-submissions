class Solution {
  public:
    bool isCyclic(int V, vector<vector<int>> &edges) {
        unordered_map<int, vector<int>> adj;
        
        for(vector<int> &edge: edges) {
            int u = edge[0];
            int v = edge[1];
            
            adj[u].push_back(v);
        }
        
        vector<int> indegre(V, 0);
        queue<int> q;
        int count = 0;
        vector<int> result;
        
        for(int u = 0; u< V; u++) {
            for(auto &v: adj[u]) {
                indegre[v]++;
            }
        }
        
        for(int i = 0; i<V; i++) {
            if(indegre[i] == 0) {
                q.push(i);
                count++;
            }
        }
        
        while(!q.empty()) {
            int u = q.front();
            q.pop();
            
            for(auto &v: adj[u]) {
                indegre[v]--;
                if(indegre[v] == 0){
                    q.push(v);
                    count++;
                }
            }
        }
        
        if(count == V) {
            return false;
        }
        
        return true;
        
    }
};
